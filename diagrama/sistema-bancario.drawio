        <mxCell id="legend" value="LEYENDA&#10;RPC: línea azul continua&#10;Sockets: línea ámbar gruesa&#10;Mensajería: línea púrpura punteada&#10;Síncrona: continua / Asíncrona: punteada&#10;&#10;Los números [1]–[8] coinciden con la matriz de interacciones.&#10;Actores: socio, cajero de ventanilla, cajero automático, analista de fraude y red interbancaria." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=10;" vertex="1" parent="1">
